{
  "opencollection": "1.0.0",
  "info": {
    "name": "Telefonie Number Management API",
    "version": "v1"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-API-Key",
      "value": "{{X-API-Key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Available Numbers",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Search Available Numbers",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.telefonie.com/v1/numbers/available",
            "params": [
              {
                "name": "country_code",
                "value": "",
                "type": "query",
                "description": "ISO 3166-1 alpha-2 country code (e.g., US, GB, DE)"
              },
              {
                "name": "type",
                "value": "",
                "type": "query",
                "description": "Type of phone number"
              },
              {
                "name": "area_code",
                "value": "",
                "type": "query",
                "description": "Desired area code for local numbers"
              },
              {
                "name": "contains",
                "value": "",
                "type": "query",
                "description": "Pattern to match in the number (digits only)"
              },
              {
                "name": "sms_enabled",
                "value": "",
                "type": "query",
                "description": "Filter to numbers with SMS capability"
              },
              {
                "name": "voice_enabled",
                "value": "",
                "type": "query",
                "description": "Filter to numbers with voice capability"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Maximum number of results to return"
              }
            ]
          },
          "docs": "Search for available phone numbers matching specified criteria."
        }
      ]
    },
    {
      "info": {
        "name": "Owned Numbers",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Owned Numbers",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.telefonie.com/v1/numbers/owned",
            "params": [
              {
                "name": "type",
                "value": "",
                "type": "query",
                "description": "Filter by number type"
              },
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Page number"
              },
              {
                "name": "page_size",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "List all phone numbers in your account."
        },
        {
          "info": {
            "name": "Purchase Number",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.telefonie.com/v1/numbers/owned",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Purchase a phone number and add it to your account."
        },
        {
          "info": {
            "name": "Get Owned Number",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.telefonie.com/v1/numbers/owned/:phone_number",
            "params": [
              {
                "name": "phone_number",
                "value": "",
                "type": "path",
                "description": "Phone number in E.164 format (URL-encoded)"
              }
            ]
          },
          "docs": "Get configuration details for a specific owned phone number."
        },
        {
          "info": {
            "name": "Update Owned Number",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.telefonie.com/v1/numbers/owned/:phone_number",
            "params": [
              {
                "name": "phone_number",
                "value": "",
                "type": "path",
                "description": "Phone number in E.164 format"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update the configuration (webhooks, friendly name) for an owned number."
        },
        {
          "info": {
            "name": "Release Number",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://api.telefonie.com/v1/numbers/owned/:phone_number",
            "params": [
              {
                "name": "phone_number",
                "value": "",
                "type": "path",
                "description": "Phone number in E.164 format"
              }
            ]
          },
          "docs": "Release a phone number from your account. This action cannot be undone."
        }
      ]
    }
  ],
  "bundled": true
}